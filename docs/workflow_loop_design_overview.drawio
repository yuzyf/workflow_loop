          <mxGeometry x="6050" y="4095" width="1720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-A2" value="FS02.A.2　AI 展示产物并询问用户；门2通过不能代替用户确认。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
