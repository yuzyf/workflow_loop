        <mxCell id="03-FS05-BG" value="" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="15850" y="2100" width="3700" height="3740" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-H" value="FS-05  plan（计划）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="15890" y="2135" width="3620" height="105" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-IN" value="FS-05.IN-A 来自 FS-04.A.OUT；IN-B 来自 FS-04.B.OUT（skip）。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=10;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="15930" y="2265" width="3540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-MAT" value="&lt;b&gt;FS05.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：计划制定者&lt;br&gt;提示词：&lt;code&gt;.workflow_loop/Template_Repository/plan/plan.md&lt;/code&gt;&lt;br&gt;规范：&lt;code&gt;.workflow_loop/Standardized_Repository/plan/plan.md&lt;/code&gt;&lt;br&gt;Artifact（产物）：plan/&amp;lt;topic&amp;gt;.md + plan/index.md&lt;br&gt;&lt;b&gt;校验现状/缺口：&lt;/b&gt;目标同时校验主题计划与索引；当前只硬校验 index；topic 写入接口需补。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="2385" width="3540" height="405" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-S1" value="FS05.1　AI 调 &lt;code&gt;workflow discuss&lt;/code&gt;：完整 stdout 职责、角色全文、提示词全文、规范全文、产出路径、下一步；Journal 记提示词/角色加载。可重复，不回滚门禁。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="2810" width="3540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-S2" value="FS05.2　AI 按本 Stage 材料与用户讨论；CLI 不参与聊天；用户明确讨论完毕。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="2985" width="3540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-S3" value="FS05.3【门1】&lt;code&gt;workflow gate plan --discuss-done&lt;/code&gt; → discussion_complete=true；Journal“门禁讨论完毕”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="15930" y="3145" width="3540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-S4" value="FS05.4　AI 写本 Stage 产物：拆分计划并确定唯一 topic，写主题文档与 index。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="3330" width="3540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-RIN" value="FS05.RETRY.IN&lt;br&gt;来自 FS05.B.RETRY.OUT：重新执行门2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;dashed=1;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="15930" y="3525" width="780" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-S5" value="FS05.5【门2】&lt;code&gt;workflow gate plan&lt;/code&gt;；要求门1；执行本 Stage 独立 code_validate（代码校验函数）。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="16730" y="3525" width="2740" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-D1" value="FS05.D1&lt;br&gt;产物校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="17300" y="3710" width="800" height="210" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-A0" value="FS05.A.0　通过分支" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8FAF2;strokeColor=#10B981;fontColor=#065F46;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="3950" width="1720" height="125" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-B0" value="FS05.B.0　失败分支" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FB7185;fontColor=#9F1239;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="17750" y="3950" width="1720" height="125" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-A1" value="FS05.A.1　code_validated=true；artifact_produced_at=时间；Journal 文件检查/代码校验 passed；stdout 要求用户检查。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8FAF2;strokeColor=#10B981;fontColor=#065F46;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="4095" width="1720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-B1" value="FS05.B.1　stdout 打印具体缺失/错误；Journal 文件检查/代码校验 failed；Stage 不推进。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FB7185;fontColor=#9F1239;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="17750" y="4095" width="1720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-A2" value="FS05.A.2　AI 展示产物并询问用户；门2通过不能代替用户确认。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="15930" y="4285" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-B2" value="FS05.B.2　AI 修正本 Stage 产物。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="17750" y="4285" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="03-FS05-A3" value="FS05.A.3【门3】&lt;code&gt;workflow gate plan --confirmed&lt;/code&gt;；要求门1+门2；user_confirmed=true，Stage.status=done。Gate3 写 state.topic；current_stage=acceptance。&lt;br&gt;Journal“用户确认/阶段推进”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="15930" y="4465" width="1720" height="230" as="geometry" />
