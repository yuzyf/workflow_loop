        <mxCell id="03-BF01-IN" value="BF-01.IN-B　来自 BF-00.B.B.OUT；project_design_initialized=true 时整段不进入。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#E11D48;fontColor=#881337;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=10;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5030" y="11105" width="4240" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-MAT" value="&lt;b&gt;BF01.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：存量产品与架构分析师&lt;br&gt;产品提示词/规范：&lt;code&gt;.workflow_loop/Template_Repository/spec/spec.md&lt;/code&gt; + &lt;code&gt;.workflow_loop/Standardized_Repository/spec/spec.md&lt;/code&gt;&lt;br&gt;架构提示词/规范：&lt;code&gt;.workflow_loop/Template_Repository/code_design/code_design.md&lt;/code&gt; + &lt;code&gt;.workflow_loop/Standardized_Repository/code_design/code_design.md&lt;/code&gt;&lt;br&gt;Artifact：spec/product.md + 多个 spec/功能&amp;lt;名&amp;gt;.md + spec/architecture_code_design.md&lt;br&gt;&lt;b&gt;本 Run 校验：&lt;/b&gt;三类产物必须一起生成或按代码重建。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="5030" y="11225" width="4240" height="420" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-S1" value="BF01.1　workflow discuss 完整 stdout 职责/角色/提示词/规范/产出/下一步；Journal 提示词/角色加载；可重复、不回滚门禁。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="5030" y="11665" width="4240" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-S2" value="BF01.2　AI 阅读代码、能运行就运行，并与用户核对当前产品行为、功能边界和架构；用户明确讨论完毕。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="5030" y="11850" width="4240" height="140" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-S3" value="BF01.3【门1】workflow gate project_design_init --discuss-done → discussion_complete=true + Journal。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5030" y="12010" width="4240" height="170" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-S4" value="BF01.4　AI 根据现有代码一次建立产品说明、全部功能设计与初步代码架构，保证三类文档相互一致。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="5030" y="12200" width="4240" height="180" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-RIN" value="BF01.RETRY.IN　重新执行门2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;dashed=1;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5030" y="12400" width="820" height="95" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-S5" value="BF01.5【门2】workflow gate project_design_init；要求门1；同时校验三类产物及本 Run 变化。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5870" y="12400" width="3400" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-BF01-D1" value="BF01.D1&lt;br&gt;校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeWidth=3;" parent="1" vertex="1">
