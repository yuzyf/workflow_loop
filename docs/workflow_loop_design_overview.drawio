        <mxCell id="03-PC02-MAT" value="&lt;b&gt;PC02.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：产品设计师&lt;br&gt;提示词：&lt;code&gt;.workflow_loop/Template_Repository/spec/spec.md&lt;/code&gt;&lt;br&gt;规范：&lt;code&gt;.workflow_loop/Standardized_Repository/spec/spec.md&lt;/code&gt;&lt;br&gt;Artifact：更新 spec/product.md；新增、修改或删除多个 spec/功能&amp;lt;名&amp;gt;.md&lt;br&gt;&lt;b&gt;本 Run 校验：&lt;/b&gt;product.md 必须有变化，并且至少一个功能文档新增、修改或删除。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=10;align=left;verticalAlign=top;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="6720" y="6550" width="2860" height="430" as="geometry" />
        </mxCell>
