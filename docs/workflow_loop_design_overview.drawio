        <mxCell id="03-FS03-H" value="FS-03  code_design（初步架构）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=3;" parent="1" vertex="1">
