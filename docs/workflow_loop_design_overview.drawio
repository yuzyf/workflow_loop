        <mxCell id="03-FS07-MAT" value="&lt;b&gt;FS07.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：测试计划制定者&lt;br&gt;提示词：&lt;code&gt;.workflow_loop/Template_Repository/qa/qa.md&lt;/code&gt;&lt;br&gt;规范：&lt;code&gt;.workflow_loop/Standardized_Repository/qa/qa.md&lt;/code&gt;&lt;br&gt;Artifact（产物）：qa/&amp;lt;topic&amp;gt;.md + qa/index.md&lt;br&gt;&lt;b&gt;校验现状/缺口：&lt;/b&gt;目标同时校验主题测试文档与索引；当前只硬校验 index。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="2385" width="3540" height="405" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-S1" value="FS07.1　AI 调 &lt;code&gt;workflow discuss&lt;/code&gt;：完整 stdout 职责、角色全文、提示词全文、规范全文、产出路径、下一步；Journal 记提示词/角色加载。可重复，不回滚门禁。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="2810" width="3540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-S2" value="FS07.2　AI 按本 Stage 材料与用户讨论；CLI 不参与聊天；用户明确讨论完毕。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="2985" width="3540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-S3" value="FS07.3【门1】&lt;code&gt;workflow gate qa --discuss-done&lt;/code&gt; → discussion_complete=true；Journal“门禁讨论完毕”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="23730" y="3145" width="3540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-S4" value="FS07.4　AI 写本 Stage 产物：依据验收条件写测试范围、步骤、边界与检查清单。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="3330" width="3540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-RIN" value="FS07.RETRY.IN&lt;br&gt;来自 FS07.B.RETRY.OUT：重新执行门2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;dashed=1;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="23730" y="3525" width="780" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-S5" value="FS07.5【门2】&lt;code&gt;workflow gate qa&lt;/code&gt;；要求门1；执行本 Stage 独立 code_validate（代码校验函数）。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="24530" y="3525" width="2740" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-D1" value="FS07.D1&lt;br&gt;产物校验通过？" style="rhombus;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;fontStyle=1;align=center;verticalAlign=middle;spacing=4;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="25100" y="3710" width="800" height="210" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-A0" value="FS07.A.0　通过分支" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8FAF2;strokeColor=#10B981;fontColor=#065F46;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="3950" width="1720" height="125" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-B0" value="FS07.B.0　失败分支" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FB7185;fontColor=#9F1239;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="25550" y="3950" width="1720" height="125" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-A1" value="FS07.A.1　code_validated=true；artifact_produced_at=时间；Journal 文件检查/代码校验 passed；stdout 要求用户检查。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8FAF2;strokeColor=#10B981;fontColor=#065F46;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="4095" width="1720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-B1" value="FS07.B.1　stdout 打印具体缺失/错误；Journal 文件检查/代码校验 failed；Stage 不推进。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF1F2;strokeColor=#FB7185;fontColor=#9F1239;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="25550" y="4095" width="1720" height="170" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-A2" value="FS07.A.2　AI 展示产物并询问用户；门2通过不能代替用户确认。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="23730" y="4285" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-B2" value="FS07.B.2　AI 修正本 Stage 产物。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="25550" y="4285" width="1720" height="160" as="geometry" />
        </mxCell>
        <mxCell id="03-FS07-A3" value="FS07.A.3【门3】&lt;code&gt;workflow gate qa --confirmed&lt;/code&gt;；要求门1+门2；user_confirmed=true，Stage.status=done。current_stage=impl。&lt;br&gt;Journal“用户确认/阶段推进”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="23730" y="4465" width="1720" height="230" as="geometry" />
        </mxCell>
