          <mxGeometry x="19750" y="2100" width="3700" height="3740" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-H" value="FS-06  acceptance（验收）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="19790" y="2135" width="3620" height="105" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-IN" value="FS-06.IN　来自 FS-05.A.OUT；state.topic 已存在。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=10;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="19830" y="2265" width="3540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-MAT" value="&lt;b&gt;FS06.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：acceptance criteria 制定者（验收条件制定者）&lt;br&gt;提示词：&lt;code&gt;.workflow_loop/Template_Repository/qa/acceptance.md&lt;/code&gt;&lt;br&gt;规范：&lt;code&gt;.workflow_loop/Standardized_Repository/qa/acceptance.md&lt;/code&gt;&lt;br&gt;Artifact（产物）：acceptance/&amp;lt;topic&amp;gt;.md&lt;br&gt;&lt;b&gt;校验现状/缺口：&lt;/b&gt;目标校验文件名与 topic 一致；当前只检查目录任意 .md。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="19830" y="2385" width="3540" height="405" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-S1" value="FS06.1　AI 调 &lt;code&gt;workflow discuss&lt;/code&gt;：完整 stdout 职责、角色全文、提示词全文、规范全文、产出路径、下一步；Journal 记提示词/角色加载。可重复，不回滚门禁。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="19830" y="2810" width="3540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-S2" value="FS06.2　AI 按本 Stage 材料与用户讨论；CLI 不参与聊天；用户明确讨论完毕。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="19830" y="2985" width="3540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-S3" value="FS06.3【门1】&lt;code&gt;workflow gate acceptance --discuss-done&lt;/code&gt; → discussion_complete=true；Journal“门禁讨论完毕”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="19830" y="3145" width="3540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-S4" value="FS06.4　AI 写本 Stage 产物：把“什么算完成”写成可判定验收条件，文件名复用 topic。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="19830" y="3330" width="3540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="03-FS06-RIN" value="FS06.RETRY.IN&lt;br&gt;来自 FS06.B.RETRY.OUT：重新执行门2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;dashed=1;strokeWidth=3;" parent="1" vertex="1">
