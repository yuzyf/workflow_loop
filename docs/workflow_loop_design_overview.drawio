        <mxCell id="03-N0" value="编号：路线/Stage.主干步骤；D=判断；A/B/C=.0 分支入口；J=显式汇合；OUT/IN=配对接续" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=16;align=left;verticalAlign=middle;spacing=10;dashed=1;strokeWidth=2;" parent="1" vertex="1">
