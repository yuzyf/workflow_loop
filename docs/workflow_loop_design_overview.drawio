        </mxCell>
        <mxCell id="03-FS02-B2" value="FS02.B.2　AI 修正本 Stage 产物。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
