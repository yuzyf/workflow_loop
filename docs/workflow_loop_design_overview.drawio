        <mxCell id="03-FS08-MAT" value="&lt;b&gt;FS08.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：实施计划制定者&lt;br&gt;提示词：&lt;code&gt;.workflow_loop/Template_Repository/impl/impl.md&lt;/code&gt;&lt;br&gt;规范：&lt;code&gt;.workflow_loop/Standardized_Repository/impl/impl.md&lt;/code&gt;&lt;br&gt;Artifact（产物）：impl/&amp;lt;topic&amp;gt;.md + 实际实施&lt;br&gt;&lt;b&gt;校验现状/缺口：&lt;/b&gt;目标校验文件名与 topic 一致并约束真实实施；当前只检查任意 impl .md。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="27630" y="2385" width="3540" height="405" as="geometry" />
        </mxCell>
        <mxCell id="03-FS08-S1" value="FS08.1　AI 调 &lt;code&gt;workflow discuss&lt;/code&gt;：完整 stdout 职责、角色全文、提示词全文、规范全文、产出路径、下一步；Journal 记提示词/��色加载。可重复，不回滚门禁。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="27630" y="2810" width="3540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="03-FS08-S2" value="FS08.2　AI 按本 Stage 材料与用户讨论；CLI 不参与聊天；用户明确讨论完毕。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
