        <mxCell id="03-FS04-EAB1" value="" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#64748B;strokeWidth=2;fontColor=#334155;fontSize=11;labelBackgroundColor=#FFFFFF;strokeColor=#E11D48;exitX=1;exitY=0.5;entryX=0;entryY=0.5;" parent="1" source="03-FS04-AB1" target="03-FS04-AB2" edge="1">
