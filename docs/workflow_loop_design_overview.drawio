        <mxCell id="03-H2" value="顶部横向看完整路线；下方每个 Stage 纵向看全部细节。Stage 之间只用配对 OUT/IN，不画跨模块长线。" style="text;html=1;strokeColor=none;fillColor=none;whiteSpace=wrap;fontColor=#475569;fontSize=22;align=left;verticalAlign=middle;" parent="1" vertex="1">
