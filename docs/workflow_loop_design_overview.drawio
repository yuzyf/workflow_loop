        <mxCell id="03-FS05-AOUT" value="FS-05.A.OUT → FS-06.IN" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;strokeWidth=4;" parent="1" vertex="1">
