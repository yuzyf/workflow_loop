        </mxCell>
        <mxCell id="03-FS03-S4" value="FS03.4　AI 写本 Stage 产物：基于已确认产品说明设计初步架构，写同一份架构文档。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
