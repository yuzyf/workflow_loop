        <mxCell id="02-BFOUT" parent="1" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=10;strokeWidth=5;" value="02-INTENT.C.OUT → 03.BF.IN" vertex="1" link="data:page/id,wf-final-03">
          <mxGeometry height="190" width="2600" x="12300" y="4890" as="geometry" />
        </mxCell>
        <mxCell id="02-N1" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=17;align=left;verticalAlign=top;spacing=14;dashed=1;strokeWidth=2;" value="&lt;b&gt;02.N1 只读状态检查的硬边界&lt;/b&gt;&lt;br&gt;&lt;br&gt;&lt;code&gt;workflow start&lt;/code&gt; 不带工作意图时：&lt;br&gt;不创建或覆盖 state.json&lt;br&gt;不生成正式 Run&lt;br&gt;不清场&lt;br&gt;不加载 Stage 提示词&lt;br&gt;不写产物&lt;br&gt;&lt;br&gt;它只回答：是否存在 active Run、下一步是什么。&lt;br&gt;&lt;br&gt;CLI 内部仍校验 .workflow_loop/ 与安装版本标记；失败属于异常保护，不画成正常流程分支。" vertex="1">
          <mxGeometry height="1050" width="3500" x="400" y="1500" as="geometry" />
        </mxCell>
        <mxCell id="02-N2" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=17;align=left;verticalAlign=top;spacing=14;dashed=1;strokeWidth=2;" value="&lt;b&gt;02.N2 带意图才创建新 Run&lt;/b&gt;&lt;br&gt;&lt;br&gt;PathComposer（阶段路径生成器）根据 intent 和架构文件等项目事实生成路线。&lt;br&gt;start 成功 stdout 打印 workflow_id、intent、完整路线、当前 Stage 与跳过标记。&lt;br&gt;下一步才是 workflow discuss，由它完整打印角色、全局写作规范、当前 Stage 提示词、阶段规范和产出路径。" vertex="1">
          <mxGeometry height="900" width="3500" x="400" y="3500" as="geometry" />
        </mxCell>
        <mxCell id="02-N3" parent="1" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#94A3B8;fontColor=#334155;fontSize=17;align=left;verticalAlign=top;spacing=14;dashed=1;strokeWidth=2;" value="&lt;b&gt;02.N3 生命周期&lt;/b&gt;&lt;br&gt;state.json 同时只有一份快照；active 禁止新开；completed / aborted 允许新开并整份覆盖旧快照。历史依靠 Journal 追加日志，而不是堆多份 state。&lt;br&gt;从零做若发现旧过程产物，03 页先画两段式清场确认；不在本页状态检查阶段删除。" vertex="1">
          <mxGeometry height="620" width="10800" x="4300" y="5500" as="geometry" />
        </mxCell>
