        <mxCell id="03-FS09-A1" value="FS09.A.1　code_validated=true；artifact_produced_at=时间；Journal 文件检查/代码校验 passed；stdout 要求用户检查。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8FAF2;strokeColor=#10B981;fontColor=#065F46;fontSize=11;align=left;verticalAlign=middle;spacing=8;strokeWidth=2;" parent="1" vertex="1">
