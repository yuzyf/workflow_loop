          <mxGeometry x="4150" y="2100" width="3700" height="3740" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-H" value="FS-02  spec（产品设计 + 功能拆分）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#2563EB;strokeColor=#2563EB;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="4190" y="2135" width="3620" height="105" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-IN" value="FS-02.IN　来自 FS-01.OUT；current_stage=spec；topic=null。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#E8F2FF;strokeColor=#2563EB;fontColor=#1E3A8A;fontSize=13;fontStyle=1;align=left;verticalAlign=middle;spacing=10;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="4230" y="2265" width="3540" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-MAT" value="&lt;b&gt;FS02.M 材料与产物&lt;/b&gt;&lt;br&gt;角色：产品设计师&lt;br&gt;提示词：&lt;code&gt;.workflow_loop/Template_Repository/spec/spec.md&lt;/code&gt;&lt;br&gt;规范：&lt;code&gt;.workflow_loop/Standardized_Repository/spec/spec.md&lt;/code&gt;&lt;br&gt;Artifact（产物）：spec/product.md + spec/功能&amp;lt;名&amp;gt;.md（多个）&lt;br&gt;&lt;b&gt;本 Run 校验：&lt;/b&gt;进入 Stage 时记录相关文件路径与内容哈希；门2要求新建 product.md，并至少新建一个功能文档。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#F8FAFC;strokeColor=#94A3B8;fontColor=#334155;fontSize=12;align=left;verticalAlign=top;spacing=10;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="4230" y="2385" width="3540" height="405" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-S1" value="FS02.1　AI 调 &lt;code&gt;workflow discuss&lt;/code&gt;：完整 stdout 职责、角色全文、提示词全文、规范全文、产出路径、下一步；Journal 记提示词/角色加载。可重复，不回滚门禁。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="4230" y="2810" width="3540" height="155" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-S2" value="FS02.2　AI 按本 Stage 材料与用户讨论；CLI 不参与聊天；用户明确讨论完毕。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="4230" y="2985" width="3540" height="140" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-S3" value="FS02.3【门1】&lt;code&gt;workflow gate spec --discuss-done&lt;/code&gt; → discussion_complete=true；Journal“门禁讨论完毕”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="4230" y="3145" width="3540" height="165" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-S4" value="FS02.4　AI 写本 Stage 产物：从零建立产品说明、功能路由，并完成多个功能设计文档；topic 仍为 null。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFFFFF;strokeColor=#64748B;fontColor=#334155;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=2;" parent="1" vertex="1">
          <mxGeometry x="4230" y="3330" width="3540" height="175" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-RIN" value="FS02.RETRY.IN&lt;br&gt;来自 FS02.B.RETRY.OUT：重新执行门2" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF7ED;strokeColor=#F97316;fontColor=#9A3412;fontSize=11;fontStyle=1;align=center;verticalAlign=middle;spacing=7;dashed=1;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="4230" y="3525" width="780" height="100" as="geometry" />
        </mxCell>
        <mxCell id="03-FS02-S5" value="FS02.5【门2】&lt;code&gt;workflow gate spec&lt;/code&gt;；要求门1；比较本 Run 前后内容哈希，必须同时出现新的 spec/product.md 与至少一份新的 spec/功能&lt;名&gt;.md；执行本 Stage 独立 code_validate（代码校验函数）。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
          <mxGeometry x="5030" y="3525" width="2740" height="165" as="geometry" />
        </mxCell>
