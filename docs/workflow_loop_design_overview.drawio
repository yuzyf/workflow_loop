        <mxCell id="03-BF01-H" value="BF-01  project_design_init（项目设计架构初始化，仅首次接入）" style="rounded=1;arcSize=5;whiteSpace=wrap;html=1;fillColor=#E11D48;strokeColor=#E11D48;fontColor=#FFFFFF;fontSize=18;fontStyle=1;align=center;verticalAlign=middle;spacing=8;strokeWidth=3;" parent="1" vertex="1">
