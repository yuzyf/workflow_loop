        </mxCell>
        <mxCell id="03-FS02-A3" value="FS02.A.3【门3】&lt;code&gt;workflow gate spec --confirmed&lt;/code&gt;；要求门1+门2；user_confirmed=true，Stage.status=done。Stage done；current_stage=code_design。&lt;br&gt;Journal“用户确认/阶段推进”。" style="rounded=1;arcSize=4;whiteSpace=wrap;html=1;fillColor=#FFF8E5;strokeColor=#F59E0B;fontColor=#92400E;fontSize=12;align=left;verticalAlign=middle;spacing=9;strokeWidth=3;" parent="1" vertex="1">
