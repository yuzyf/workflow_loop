./node_modules/.bin/vitest run 'app/chat/__tests__/page.test.tsx' -t '__workflow_no_match__' --passWithNoTests --reporter=junit --outputFile='/Users/yu/business_qt/ai_qt/workflow_loop/.workflow_loop/spike_tmp/结构化测试报告能否精确证明真实测试已执行/vitest-zero.xml'
