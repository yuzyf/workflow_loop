./node_modules/.bin/vitest run '__workflow_no_match__.test.ts' --passWithNoTests --reporter=default --reporter=junit --outputFile.junit='/Users/yu/business_qt/ai_qt/workflow_loop/.workflow_loop/spike_tmp/结构化测试报告能否精确证明真实测试已执行/vitest-zero-files.xml'
